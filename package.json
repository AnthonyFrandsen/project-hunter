{
  "name": "hunter",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension + local helper server that turns an open job listing into a tailored, one-page resume.",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "shared",
    "server",
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "22.20.1",
    "mocha": "12.0.0-rc.5",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
